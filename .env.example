# ============================================================================
# Personal Assistant Bot — consolidated configuration for the online deploy.
#
#   cp .env.example .env   then fill in the values below.
#
# docker compose reads this file automatically. All three services draw their
# settings from here; shared values (NOTION_TOKEN, TELEGRAM_BOT_TOKEN) are
# defined once.
# ============================================================================

# --- Telegram (used by capture-receiver + outbox-sender) --------------------
# One bot, two roles. Token from @BotFather. Keep it secret.
TELEGRAM_BOT_TOKEN=

# Comma-separated numeric Telegram user IDs allowed to talk to the bot.
# Message @userinfobot to find yours, or watch the receiver logs.
TELEGRAM_ALLOWED_USER_IDS=

# --- Notion (used by all three services) ------------------------------------
# Internal integration token. Must be shared with the System Schema page, the
# Inbox, the Outbox, and every database registered on the schema page.
NOTION_TOKEN=

# Data-source IDs / page pointers.
INBOX_DATA_SOURCE_ID=
OUTBOX_DATA_SOURCE_ID=
SCHEMA_PAGE_ID=

# --- Anthropic (used by processing-agent) -----------------------------------
ANTHROPIC_API_KEY=

# --- Tuning (optional — sensible defaults baked into compose) ---------------
POLL_INTERVAL_SECONDS=10
PROCESSING_RECLAIM_MINUTES=5
SCHEMA_RELOAD_MINUTES=15
