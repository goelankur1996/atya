# ATYA v2 settings. Copy to .env and fill in. Never commit .env.

# Telegram bot token from @BotFather. Use the TEST bot until cutover.
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user ID (message @userinfobot to find it).
# This user can send /invite; their account is created on their first message.
OWNER_TELEGRAM_USER_ID=

ANTHROPIC_API_KEY=

# Voyage AI key for semantic search (dash.voyageai.com). Without it, search
# uses full text only.
VOYAGE_API_KEY=

# Optional
# Public address of the web view (/web sends sign-in links to it).
# Locally: http://localhost:8080. On the server it's set by deploy/enable-web.sh.
WEB_BASE_URL=
OWNER_TIMEZONE=Asia/Kolkata
POSTGRES_PASSWORD=atya-local
POLL_INTERVAL_SECONDS=5
PROCESSING_RECLAIM_MINUTES=5
MAX_ATTEMPTS=3
