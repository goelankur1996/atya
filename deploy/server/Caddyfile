# Caddy gets and renews the HTTPS certificate for WEB_DOMAIN automatically.
{$WEB_DOMAIN} {
	encode gzip
	# Phone call audio (Plivo) goes to the audio bridge; everything else to the app.
	handle /plivo/ws/* {
		reverse_proxy callbridge:8099
	}
	handle {
		reverse_proxy app:8080
	}
	header -Server
	header Strict-Transport-Security "max-age=31536000"
}

# The old address(es) and www forward here, keeping the path (old links keep working).
www.{$WEB_DOMAIN}, {$WEB_REDIRECT_FROM:localhost} {
	redir https://{$WEB_DOMAIN}{uri} permanent
}
